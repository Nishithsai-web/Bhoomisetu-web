# Base URL of the Bhoomisetu API, read on the server only.
BHOOMISETU_API_URL=http://localhost:5080

# Set to true only when this server is reachable solely through a load balancer that appends the client IP
# to X-Forwarded-For. Then the visitor's IP is passed to the API for per-visitor rate limits.
BHOOMISETU_BEHIND_LOAD_BALANCER=false

# Optional: Cloudflare Turnstile site key. Set it together with Captcha__Provider=turnstile and
# Captcha__SecretKey on the API to ask for a human check from the second code request.
BHOOMISETU_TURNSTILE_SITE_KEY=
